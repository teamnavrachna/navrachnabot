# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./navarachna.db

# Cycle interval in minutes for topic discovery and posting
CYCLE_INTERVAL_MINUTES=30

# Minimum publication score threshold (0-100)
PUBLISH_SCORE_THRESHOLD=70
